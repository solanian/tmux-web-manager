# Optional overrides for tmux-web-manager.service
#
# Copy this file to:
#   ~/.config/tmux-web-manager/tmux-web-manager.env
# and edit it for your machine.

TMUX_WEB_MANAGER_ROOT=$HOME/path/to/tmux-web-manager
ALLOWED_PROJECT_ROOTS=$HOME/workspace
BASE_URL=http://127.0.0.1:38187
BACKEND_PUBLIC_URL=http://127.0.0.1:38188
BACKEND_NAME=
BACKEND_AUTH_TOKEN=
