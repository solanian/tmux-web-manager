[Unit]
Description=tmux-web-manager main service
After=default.target

[Service]
Type=simple
Environment=TMUX_WEB_MANAGER_ROOT=%h/tmux-web-manager
Environment=HOST=0.0.0.0
Environment=PORT=38187
Environment=BACKEND_HOST=0.0.0.0
Environment=BACKEND_PORT=38188
Environment=BACKEND_PUBLIC_URL=http://127.0.0.1:38188
Environment=TMUX_SOCKET_MODE=default
Environment=SESSION_PREFIX=tmux-web-manager
EnvironmentFile=-%h/.config/tmux-web-manager/tmux-web-manager.env
WorkingDirectory=%h
ExecStart=/usr/bin/env bash -lc 'cd "$TMUX_WEB_MANAGER_ROOT" && exec node dist/index.js main'
Environment=HOST=0.0.0.0
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
